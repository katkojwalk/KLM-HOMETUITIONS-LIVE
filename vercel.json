{
  "version": 2,
  "installCommand": "npm run install-all --legacy-peer-deps",
  "buildCommand": "cd client && npm install --legacy-peer-deps && CI=false npx react-scripts build",
  "outputDirectory": "client/build",
  "env": {
    "CI": "false"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
